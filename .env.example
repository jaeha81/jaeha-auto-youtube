# ─────────────────────────────────────────
# Windows 한글 인코딩 문제 방지 (필수)
PYTHONUTF8=1
# 생성 방식 선택 (한 줄만 바꾸면 전환됨)
# cli  = A안: $100 구독 범위 내 운영 (기본값)
# api  = B안: 구독 외 소액 과금, 더 빠름
GENERATION_MODE=cli
# ─────────────────────────────────────────

# Anthropic (B안으로 전환 시 필요)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# YouTube / Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

# Bucky Obsidian Vault
BUCKY_VAULT_PATH=G:\내 드라이브\obsidian-agent-brain-system\

# 프로젝트 경로
CONTENT_BASE_PATH=D:\ai프로젝트\유튜브자동화시작하기\content
